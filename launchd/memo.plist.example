<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace each __ROOT__ with the full path of this repository. See "Start at login" in README.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>memo.server</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>__ROOT__/scripts/start.sh</string></array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <!-- The tmux sessions of the agents must continue when launchd restarts the server. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>__ROOT__/data/server.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/server.log</string>
</dict>
</plist>
