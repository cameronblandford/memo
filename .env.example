# Memo configuration. Copy this file to .env, then run: chmod 600 .env
# Do not commit .env.
HOST=127.0.0.1
PORT=3280
DATABASE_PATH=./data/memo.db
# Only for a computer that runs a remote agent: the address of the Memo server on a different computer.
# MEMO_URL=https://memo.your-tailnet.ts.net
# The name of the person who owns the queue. Agents send memos to this name. Only a-z, 0-9 and "-".
MEMO_OWNER=owner
# The token of the owner and of the agent main. Make a token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEMO_TOKEN=<random>
# The restricted token of the liaison run. It must be different from MEMO_TOKEN.
MEMO_LIAISON_TOKEN=<random>

# Tailscale (optional). With the two lines below, the owner needs no token on the pages through Tailscale Serve.
# The login name of your Tailscale account, and the host name and port that Tailscale Serve gives for Memo.
# MEMO_TAILSCALE_LOGIN=you@example.com
# MEMO_TAILSCALE_HOST=your-mac.your-tailnet.ts.net:8443

# Discord (optional). Leave these out if you do not use the Discord watcher.
# The full path of a command that reads and sends Discord messages. The liaison run can use only this command and memo.
DISCORD_CLI=
# The Discord account id of the owner. Only a message from this account can go on to another agent.
DISCORD_OWNER_ID=
# Channel ids that the liaison reads in full, with commas between them.
DISCORD_MAIL_CHANNELS=
# Mail channels where a message of the owner counts with no mention of the bot.
DISCORD_OWNER_MAIL_CHANNELS=
